# חיבור למסד Postgres (למשל Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# מחרוזת אקראית ארוכה. ליצירה: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# כתובת האתר (בפיתוח: http://localhost:3000, בפרודקשן: הכתובת האמיתית)
NEXTAUTH_URL="http://localhost:3000"

# חשבון המנהל/ת הראשוני (נוצר ע"י npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_FIRST_NAME="שם"
ADMIN_LAST_NAME="משפחה"
